local function isTargetValid(plr)
    if not plr or plr == LocalPlayer then return false end
    local char = plr.Character
    if not char or not char:FindFirstChild("Humanoid") or char.Humanoid.Health <= 0 then return false end
    local myT, thrT = LocalPlayer:GetAttribute("TeamID"), plr:GetAttribute("TeamID")
    if myT ~= nil and thrT ~= nil then return tostring(myT) ~= tostring(thrT) end
    if LocalPlayer.Team and plr.Team then return LocalPlayer.Team ~= plr.Team end
    return true
end

local function getValidHead(char)
    local head = char:FindFirstChild("Head")
    if not head then return nil end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {LocalPlayer.Character, Camera}
    local result = workspace:Raycast(Camera.CFrame.Position, (head.Position - Camera.CFrame.Position).Unit * 1000, params)
    return (result == nil or result.Instance:IsDescendantOf(char)) and head or nil
end

local function GetClosestPlayerAimbot()
    local closest = nil
    local shortestDistance = FOVRadius
    for _, player in pairs(Players:GetPlayers()) do
        if isTargetValid(player) and player.Character:FindFirstChild("HumanoidRootPart") then
            local head = player.Character:FindFirstChild("Head") or player.Character.HumanoidRootPart
            
            if AimbotWallCheck then
                local valid = getValidHead(player.Character)
                if not valid then continue end
            end

            local params = RaycastParams.new()
            params.FilterType = Enum.RaycastFilterType.Exclude
            params.FilterDescendantsInstances = {LocalPlayer.Character, Camera}
            local result = workspace:Raycast(Camera.CFrame.Position, (head.Position - Camera.CFrame.Position).Unit * 1000, params)
            if result == nil or result.Instance:IsDescendantOf(player.Character) then
                local pos, onScreen = Camera:WorldToViewportPoint(head.Position)
                if onScreen then
                    local distance = (Vector2.new(pos.X, pos.Y) - Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)).Magnitude
                    if distance < shortestDistance then
                        shortestDistance = distance
                        closest = player
                    end
                end
            end
        end
    end
    return closest
end

local function GetClosestTargetPlayer()
    local closest = nil
    local shortestDist = math.huge
    for _, plr in ipairs(Players:GetPlayers()) do
        if isTargetValid(plr) and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
            local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if myRoot then
                local dist = (myRoot.Position - plr.Character.HumanoidRootPart.Position).Magnitude
                if dist < shortestDist then
                    shortestDist = dist
                    closest = plr
                end
            end
        end
    end
    return closest
end

RunService.RenderStepped:Connect(function()
    UpdateFOV()

    local enemyVisible = false
    for _, plr in ipairs(Players:GetPlayers()) do
        if isTargetValid(plr) and plr.Character:FindFirstChild("Head") then
            local _, onScreen = Camera:WorldToViewportPoint(plr.Character.Head.Position)
            if onScreen then enemyVisible = true break end
        end
    end

    if enemyVisible and (KatanaFlashEnabled or EscudoEnabled) then
        ManipulationText = "MANIPULATED"
    else
        ManipulationText = ""
    end
    ManipLabel.Text = ManipulationText

    if not getgenv().SilentAimEnabled then activeTargetPos = nil return end
    local bestHead, shortestDist, center = nil, 9e9, Camera.ViewportSize / 2
    for _, plr in ipairs(Players:GetPlayers()) do
        local char = plr.Character
        if char and isTargetValid(plr) then
            local head = char:FindFirstChild("Head")
            if head then
                local dist = (head.Position - Camera.CFrame.Position).Magnitude
                local pos, onScreen = Camera:WorldToViewportPoint(head.Position)
                if onScreen and dist <= SilentFOVRadius then
                    local fovDist = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                    if fovDist < shortestDist then
                        if SilentWallCheck then
                            local valid = getValidHead(char)
                            if not valid then continue end
                        end

                        local valid = getValidHead(char)
                        if valid then shortestDist = fovDist; bestHead = valid end
                    end
                end
            end
        end
    end
    activeTargetPos = bestHead and bestHead.Position or nil
end)

