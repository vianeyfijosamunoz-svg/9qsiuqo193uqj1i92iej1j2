local tickCount = 0

RunService.RenderStepped:Connect(function(dt)
    tickCount = tickCount + 1

    if AimbotEnabled then
        local target = GetClosestPlayerAimbot()
        if target and isTargetValid(target) and target.Character then
            local head = target.Character:FindFirstChild("Head") or target.Character:FindFirstChild("HumanoidRootPart")
            if head then
                Camera.CFrame = CFrame.new(Camera.CFrame.Position, head.Position)
            end
        end
    end

    if OrbitActive then
        local target = nil
        for _, p in ipairs(Players:GetPlayers()) do
            if isTargetValid(p) then target = p break end
        end

        if target and isTargetValid(target) and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
            local hrp = target.Character.HumanoidRootPart
            local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if myRoot then
                local angle = (tickCount * (OrbitSpeed * 0.05)) * OrbitAngle
                myRoot.CFrame = hrp.CFrame * CFrame.Angles(0, angle, 0) * CFrame.new(0, OrbitHeight, OrbitStuds)
            end
        else
            if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                local spamOffset = Vector3.new(math.random(-5937473, 5937473), math.random(1000, 5000), math.random(-5937473, 5937473))
                LocalPlayer.Character.HumanoidRootPart.CFrame = CFrame.new(spamOffset) * CFrame.Angles(math.rad(tickCount * 393818), 0, 0)
            end
        end
    end

    if RagebotEnabled then
        local target = GetClosestTargetPlayer()
        local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")

        if myRoot then
            if target and isTargetValid(target) and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
                local tHrp = target.Character.HumanoidRootPart
                local tHead = target.Character:FindFirstChild("Head") or tHrp

                if RageMode == "GUN" then
                    if AntiKnifeEnabled then
                        myRoot.CFrame = tHrp.CFrame * CFrame.new(2.5, 0, 0)
                        Camera.CFrame = CFrame.new(Camera.CFrame.Position, tHead.Position)
                    else
                        myRoot.CFrame = tHrp.CFrame * CFrame.new(0, 0, 2.5)
                        Camera.CFrame = CFrame.new(Camera.CFrame.Position, tHead.Position)
                    end
                elseif RageMode == "MELE" then
                    local angle = tickCount * 0.5
                    myRoot.CFrame = tHrp.CFrame * CFrame.Angles(0, angle, 0) * CFrame.new(0, 0, 1)
                elseif RageMode == "KNIFE" then
                    myRoot.CFrame = CFrame.new(tHrp.Position - (tHrp.CFrame.LookVector * 2), tHrp.Position)
                elseif RageMode == "SLINGSHOT (BETA)" then
                    local angle = tickCount * 50000 * 0.01
                    myRoot.CFrame = tHrp.CFrame * CFrame.Angles(0, angle, 0) * CFrame.new(0, 1.5, 3)
                    Camera.CFrame = CFrame.new(Camera.CFrame.Position, tHead.Position)
                end
            else
                local spamOffset = Vector3.new(math.random(-9000000, 9000000), math.random(1000, 9000000), math.random(-9000000, 9000000))
                myRoot.CFrame = CFrame.new(spamOffset) * CFrame.Angles(math.rad(tickCount * 900000), 0, 0)
            end
        end
    end
end)

